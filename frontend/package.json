    "ai": "^6.0.200",
    "camelcase-keys": "^10.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.17.0",
    "mapbox-gl": "^3.24.0",
    "nanoid": "^5.1.11",
