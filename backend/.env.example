# Copy to .env and fill in values

# PostgreSQL
POSTGRES_USER=ctc
POSTGRES_PASSWORD=ctcpassword
POSTGRES_DB=ctc_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# LLM
LLM_PROVIDER=
LLM_MODEL=
TRIAGE_LLM_MODEL=
TRIAGE_HISTORY_TURNS=3
OLLAMA_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=sk-...

# Evaluation
EVAL_LLM_MODEL=gpt-5.4-mini
DEEPEVAL_TELEMETRY_OPT_OUT=YES
EVAL_WEBHOOK_SECRET=
EVAL_MAX_CONCURRENCY=8
EVAL_HTTP_MAX_CONNECTIONS=8

# Embeddings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_BATCH_SIZE=16
EMBEDDING_WARMUP=false

ENVIRONMENT=development

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_CLINICAL_TRIALS_PROMPT_NAME=clinical-trial-chatbot-system
LANGFUSE_TRIAGE_PROMPT_NAME=clinical-trial-chatbot-triage
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_SEED_PROMPT=true
LANGFUSE_CAPTURE_CONTENT=

CORS_ALLOW_ORIGINS=["http://localhost","http://localhost:5173","http://localhost:4173"]

# Search
RESTRICT_TO_PROVINCE=Ontario

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_TTL_SECONDS=3600

# Translation (summary-panel language picker)
# French is served from the seeded *_fr columns and never reaches the API; the
# other eight languages are machine-translated and cached in Redis by content hash.
# google = Cloud Translation v3, llm = the translate-only agent (agents/translation).
TRANSLATION_PROVIDER=google
GOOGLE_PROJECT_ID=
TRANSLATION_LLM_MODEL=
TRANSLATION_LLM_RETRIES=2
TRANSLATION_LLM_CONCURRENCY=10
TRANSLATION_LLM_FALLBACK_MAX_LINES=20
# Path to the service-account JSON, read by the Google client itself. Deploy it
# 0600 next to this file and mount it read-only into the container.
GOOGLE_APPLICATION_CREDENTIALS=
TRANSLATION_REQUEST_TIMEOUT=30.0
TRANSLATION_CACHE_TTL_SECONDS=2592000
REDIS_URL=redis://localhost:6379/0
