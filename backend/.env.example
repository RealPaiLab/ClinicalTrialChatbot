# Copy to .env and fill in values

# PostgreSQL
POSTGRES_USER=ctc
POSTGRES_PASSWORD=ctcpassword
POSTGRES_DB=ctc_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# LLM
LLM_PROVIDER=
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=sk-...

# Evaluation
EVAL_LLM_MODEL=gpt-5.4-mini
DEEPEVAL_TELEMETRY_OPT_OUT=YES
EVAL_WEBHOOK_SECRET=
EVAL_MAX_CONCURRENCY=8
EVAL_HTTP_MAX_CONNECTIONS=8

# Embeddings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_BATCH_SIZE=16
EMBEDDING_WARMUP=false

ENVIRONMENT=development

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PROMPT_NAME=clinical-trial-chatbot-system
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_SEED_PROMPT=true
LANGFUSE_CAPTURE_CONTENT=

CORS_ALLOW_ORIGINS=["http://localhost","http://localhost:5173","http://localhost:4173"]

# Search
RESTRICT_TO_PROVINCE=Ontario

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_TTL_SECONDS=3600
