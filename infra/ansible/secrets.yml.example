# --- App VM (backend) ---
openai_api_key: ""
app_postgres_password: ""
ollama_base_url: ""
eval_webhook_secret: ""   # shared secret

# Trial source for the ingestion pipeline.
ctc_api_base_url: ""

# Frontend runtime config
mapbox_token: ""

# Cloudflare Turnstile: secret key (server-side) + site key (public).
turnstile_secret_key: ""
turnstile_site_key: ""

# --- Staging (internal VM) ---
# Staging shares openai_api_key, mapbox_token and the Langfuse keys with production
staging_app_postgres_password: ""

# --- Langfuse VM ---
langfuse_postgres_password: ""
langfuse_salt: ""
langfuse_encryption_key: ""     # 64 hex chars (openssl rand -hex 32)
langfuse_nextauth_secret: ""    # openssl rand -base64 32
clickhouse_password: ""
minio_root_user: ""
minio_root_password: ""

# LANGFUSE_INIT_* bootstrap the Langfuse VM (org/project/admin user) on first start.
langfuse_init_org_id: ""
langfuse_init_project_id: ""
langfuse_init_project_public_key: ""   # backend LANGFUSE_PUBLIC_KEY
langfuse_init_project_secret_key: ""   # backend LANGFUSE_SECRET_KEY
langfuse_init_user_email: ""
langfuse_init_user_name: ""
langfuse_init_user_password: ""

# --- GHCR pull (configured on the VM during prepare; needs read:packages) ---
ghcr_pull_username: ""
ghcr_pull_token: ""

# --- Public SSH keys authorized on the deploy user ---
# Add your own key AND the CI deploy key's public half, so
# both manual runs and the deploy job can SSH in as the deploy user.
deploy_authorized_keys:
  - ""   # ssh-ed25519 AAAA... you@host
  # - "" # ssh-ed25519 AAAA... ci-deploy
