# Managed by Ansible (app role). Deployed compose for {{ deploy_slot }}.
# Prebuilt GHCR images, data stores bound to localhost, nginx on this host fronts the ports.
# The explicit project name pins the container and volume namespace so a co-hosted
# environment can never share a volume with its neighbour.
name: {{ compose_project_name }}

services:
  postgres:
    image: pgvector/pgvector:pg13
    restart: unless-stopped
    environment:
      POSTGRES_USER: {{ postgres_user }}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: {{ postgres_db }}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    ports:
      - "127.0.0.1:{{ postgres_host_port }}:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgres_user }} -d {{ postgres_db }}"]
      interval: 10s
      timeout: 5s
      retries: 5

  redis:
    image: redis:alpine
    restart: unless-stopped
    volumes:
      - redis_data:/data
    ports:
      - "127.0.0.1:{{ redis_host_port }}:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 10

  backend:
    image: {{ backend_image }}:${BACKEND_VERSION:-{{ backend_version }}}
    restart: unless-stopped
    env_file:
      - .env
    environment:
      ENVIRONMENT: "{{ app_environment }}"
      POSTGRES_HOST: postgres
      POSTGRES_DB: {{ postgres_db }}
      POSTGRES_USER: {{ postgres_user }}
      REDIS_URL: redis://redis:6379/0
      LLM_PROVIDER: {{ llm_provider }}
      LLM_MODEL: {{ llm_model }}
      EMBEDDING_PROVIDER: {{ embedding_provider }}
      EMBEDDING_MODEL: "{{ embedding_model }}"
      LANGFUSE_HOST: {{ langfuse_host }}
{% if langfuse_capture_content is defined %}
      LANGFUSE_CAPTURE_CONTENT: "{{ langfuse_capture_content | string | lower }}"
{% endif %}
{% if langfuse_seed_prompt is defined %}
      LANGFUSE_SEED_PROMPT: "{{ langfuse_seed_prompt | string | lower }}"
{% endif %}
{% if langfuse_prompt_label | default('') | length > 0 %}
      LANGFUSE_PROMPT_LABEL: "{{ langfuse_prompt_label }}"
{% endif %}
      CORS_ALLOW_ORIGINS: '{{ cors_allow_origins | to_json }}'
{% if restrict_to_province | default('') | length > 0 %}
      RESTRICT_TO_PROVINCE: "{{ restrict_to_province }}"
{% endif %}
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    ports:
      - "127.0.0.1:{{ backend_host_port }}:8000"

  frontend:
    image: {{ frontend_image }}:${FRONTEND_VERSION:-{{ frontend_version }}}
    restart: unless-stopped
    environment:
      API_BASE_URL: "{{ api_base_url }}"
      MAPBOX_TOKEN: "{{ mapbox_token }}"
      ENVIRONMENT: "{{ app_environment }}"
      TURNSTILE_SITE_KEY: "{{ app_secrets.turnstile_site_key }}"
    depends_on:
      - backend
    ports:
      - "127.0.0.1:{{ frontend_host_port }}:80"

volumes:
  postgres_data:
  redis_data:
