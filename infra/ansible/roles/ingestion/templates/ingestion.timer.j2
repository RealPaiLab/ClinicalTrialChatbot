# Managed by Ansible (ingestion role). A oneshot cannot overlap itself.
[Unit]
Description=Scheduled {{ pipeline | upper }} trial ingestion ({{ app_environment }})

[Timer]
OnCalendar={{ schedule.on_calendar }}
Persistent=true
AccuracySec=1min
Unit={{ ingestion_unit_prefix }}-{{ pipeline }}.service

[Install]
WantedBy=timers.target
