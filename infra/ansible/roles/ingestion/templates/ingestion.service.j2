# Managed by Ansible (ingestion role). Refreshes the {{ pipeline }} trial corpus.
# `compose run` propagates the exit code, so a failed stage fails the unit.
[Unit]
Description={{ pipeline | upper }} trial ingestion pipeline ({{ app_environment }})
Wants=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User={{ deploy_user }}
WorkingDirectory={{ app_dir }}
ExecStart=/usr/bin/docker compose run --rm backend python -m scripts.run {{ pipeline }}
TimeoutStartSec={{ schedule.timeout_sec | default(ingestion_timeout_sec) }}
