# Managed by Ansible (reverse_proxy role).
{% if reverse_proxy_rate_limit_enabled | default(true) %}
# Rate-limit zones (http context). Chat is tighter: each turn is an expensive LLM call.
limit_req_zone $binary_remote_addr zone=chat:10m rate={{ reverse_proxy_chat_rate }};
limit_req_zone $binary_remote_addr zone=api:10m rate={{ reverse_proxy_api_rate }};
{% endif %}
server {
    listen 80;
    server_name {{ public_domain }}{% if external_domain | default('') %} {{ external_domain }}{% endif %};

    location /.well-known/acme-challenge/ {
        alias {{ reverse_proxy_acme_webroot }}/;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
server {
    listen 443 ssl;
    server_name {{ public_domain }}{% if external_domain | default('') %} {{ external_domain }}{% endif %};

    ssl_certificate {{ reverse_proxy_cert_fullchain }};
    ssl_certificate_key {{ reverse_proxy_cert_privkey }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 10m;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Chat API -> backend. Tighter rate limit (each turn is an expensive LLM call). SSE-safe.
    location /api/chat/ {
{% if reverse_proxy_rate_limit_enabled | default(true) %}
        limit_req zone=chat burst={{ reverse_proxy_chat_burst }} nodelay;
        limit_req_status 429;
{% endif %}
        proxy_pass http://127.0.0.1:8000/chat/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
    # Rest of the API -> backend container (localhost-bound). SSE-safe: never buffer the stream.
    location /api/ {
{% if reverse_proxy_rate_limit_enabled | default(true) %}
        limit_req zone=api burst={{ reverse_proxy_api_burst }} nodelay;
        limit_req_status 429;
{% endif %}
        proxy_pass http://127.0.0.1:8000/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
    # SPA -> frontend container (localhost-bound).
    location / {
        proxy_pass http://127.0.0.1:8080/;
    }
}
