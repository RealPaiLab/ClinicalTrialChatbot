# Managed by Ansible (reverse_proxy role). Single source of truth: certbot only
# issues/renews the cert and never edits this file.
{% macro app_locations() %}
    # Chat API -> backend. Tighter rate limit (each turn is an expensive LLM call).
    location /api/chat/ {
{% if reverse_proxy_rate_limit_enabled | default(true) %}
        limit_req zone=chat burst={{ reverse_proxy_chat_burst }} nodelay;
        limit_req_status 429;
{% endif %}
        proxy_pass http://127.0.0.1:8000/chat/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
    # Rest of the API -> backend (localhost-bound). Looser volumetric limit.
    location /api/ {
{% if reverse_proxy_rate_limit_enabled | default(true) %}
        limit_req zone=api burst={{ reverse_proxy_api_burst }} nodelay;
        limit_req_status 429;
{% endif %}
        proxy_pass http://127.0.0.1:8000/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
    # SPA -> frontend container (localhost-bound).
    location / {
        proxy_pass http://127.0.0.1:8080/;
    }
{% endmacro %}
{% macro langfuse_locations() %}
    location / {
        proxy_pass http://127.0.0.1:3000/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
{% endmacro %}
{% set locations = app_locations if proxy_type == 'app' else langfuse_locations %}
{% if proxy_type == 'app' and reverse_proxy_rate_limit_enabled | default(true) %}
# Rate-limit zones (http context).
limit_req_zone $binary_remote_addr zone=chat:10m rate={{ reverse_proxy_chat_rate }};
limit_req_zone $binary_remote_addr zone=api:10m rate={{ reverse_proxy_api_rate }};
{% endif %}
server {
    listen 80;
    server_name {{ public_domain }};

    location /.well-known/acme-challenge/ {
        root {{ reverse_proxy_certbot_webroot }};
    }

{% if tls_enabled %}
    location / {
        return 301 https://$host$request_uri;
    }
{% else %}
    client_max_body_size 10m;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
{{ locations() }}
{% endif %}
}
{% if tls_enabled %}
server {
    listen 443 ssl;
    server_name {{ public_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ public_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ public_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 10m;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
{{ locations() }}
}
{% endif %}
