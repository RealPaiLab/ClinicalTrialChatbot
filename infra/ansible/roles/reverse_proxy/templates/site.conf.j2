# Managed by Ansible (reverse_proxy role).
# certbot rewrites this to add the :443 server block and the 80->443 redirect.
server {
    listen 80;
    server_name {{ public_domain }};

    client_max_body_size 10m;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

{% if proxy_type == 'app' %}
    # API → backend container (localhost-bound)
    location /api/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    # SPA → frontend container (localhost-bound)
    location / {
        proxy_pass http://127.0.0.1:8080/;
    }
{% else %}
    # Langfuse dashboard → langfuse-web container (localhost-bound)
    location / {
        proxy_pass http://127.0.0.1:3000/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
{% endif %}
}
